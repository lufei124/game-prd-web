# 将本文件复制为 .env 并填写真实值；不要提交 .env。
WORKBENCH_ANTHROPIC_API_KEY=
# 默认订阅登录：启动后在设置中点击「使用 ChatGPT 登录」。无需 API Key。
WORKBENCH_CODEX_AUTH_MODE=subscription
# 仅 auth mode 为 api-key 时使用，按 API 单独计费。
WORKBENCH_CODEX_API_KEY=
# 留空自动检测依赖附带的 Codex CLI。
WORKBENCH_CODEX_BINARY=
# WORKBENCH_DATA=/absolute/path/forge-data
PORT=4317
